<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fluXis.Shared</AssemblyName>
    <PackageId>fluXis.Shared</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--    <DefineConstants>CLOSED_TESTING</DefineConstants>-->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>fluXis</Title>
    <PackageId>InventiveRhythm.fluXis</PackageId>
    <PackageReleaseNotes>Automated release.</PackageReleaseNotes>
    <Description>A community-driven rhythm game with a focus on creativity and expression.</Description>
    <PackageIcon>nuget-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0"/>
    <PackageReference Include="FastCloner" Version="3.5.6"/>
    <PackageReference Include="flustix.Midori" Version="2026.927.0"/>
    <PackageReference Include="Humanizer.Core" Version="3.0.10"/>
    <PackageReference Include="InventiveRhythm.Framework" Version="2026.1029.0"/>
    <PackageReference Include="NCalcSync" Version="7.1.0"/>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8"/>
    <PackageReference Include="NLua" Version="1.7.9"/>
    <PackageReference Include="Realm" Version="20.1.0"/>
    <PackageReference Include="rhym" Version="2026.1019.0"/>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11">
      <NoWarn>NU1902,NU1903</NoWarn>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7">
      <NoWarn>NU1902,NU1903</NoWarn>
    </PackageReference>
    <PackageReference Include="System.IO.Hashing" Version="10.0.11"/>
  </ItemGroup>
  <ItemGroup Label="Code Analysis">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="All"/>
    <AdditionalFiles Include="..\CodeAnalysis\BannedSymbols.txt"/>
  </ItemGroup>
</Project>
